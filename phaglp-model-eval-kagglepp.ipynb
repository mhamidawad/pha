  {
   "cell_type": "code",
   "id": "download-models",
   "metadata": {},
   "source": [
    "from huggingface_hub import HfApi, hf_hub_download\nfrom pathlib import Path\n\nMODELS_DIR = Path(\"/kaggle/working/models\")\nMODELS_DIR.mkdir(exist_ok=True)\n\nMODEL_REPOS = [\n    (\"Qwen3-Coder-30B-A3B\", \"unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF\"),\n    (\"Gemma-4-12B-QAT\", \"google/gemma-4-12b-it-qat-q4_0-gguf\"),\n]\n\ndef pick_gguf(repo_id):\n    api = HfApi()\n    files = api.list_repo_files(repo_id)\n    ggufs = [f for f in files if f.endswith(\".gguf\")]\n    if not ggufs:\n        raise FileNotFoundError(f\"No GGUF files in {repo_id}\")\n    for pref in [\"Q4_K_M\", \"Q4_0\", \"Q5_K_M\", \"Q6_K\", \"Q8_0\"]:\n        matches = [f for f in ggufs if pref in f.upper()]\n        if matches:\n            return matches[0]\n    return ggufs[0]\n\nmodel_paths = {}\nfor name, repo_id in MODEL_REPOS:\n    try:\n        fname = pick_gguf(repo_id)\n        print(f\"Downloading {fname} from {repo_id} ...\")\n        path = hf_hub_download(repo_id=repo_id, filename=fname,\n                               local_dir=MODELS_DIR, local_dir_use_symlinks=False)\n        model_paths[name] = Path(path)\n        print(f\"OK {name}: {path} ({path.stat().st_size / 1e9:.1f} GB)\")\n    except Exception as e:\n        print(f\"FAIL {name}: {e}\")\n\nprint(f\"\\nModels ready: {list(model_paths.keys())}\")"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "code",
   "id": "eval-harness",
   "metadata": {},
   "source": [
    "#!/usr/bin/env python3\n",
    "\"\"\"PHAGLP GGUF eval harness on Kaggle.\"\"\"\n",
    "import json\nimport re\nimport subprocess\nimport time\nfrom pathlib import Path\n\nfrom llama_cpp import Llama\n\nREPO = Path(\"/kaggle/working/testa-phaglp2\")\nRESULTS = Path(\"/kaggle/working/eval_results.json\")\n\nPROMPTS = [\n    {\n        \"id\": \"chart-recharts-v3\",\n        \"title\": \"Fix recharts v3 className type error\",\n        \"prompt\": \"\"\"You are fixing a Next.js 15 + TypeScript project.\n\nFile: src/components/ui/chart.tsx\n\nChartLegendContent is a shadcn wrapper over RechartsPrimitive.Legend.\nAfter upgrading recharts v2 -> v3, the build fails:\n\nType error: Property 'className' does not exist on type\n'Omit<Props, \"ref\" | \"layout\" | \"verticalAlign\" | \"payload\"> & {...}'\n\nFix: add `className?: string` to the intersection type of ChartLegendContent props.\nReturn ONLY the corrected code block for the ChartLegendContent type declaration,\nwrapped in tsx markdown fences. Do not explain.\"\"\",\n        \"file\": \"src/components/ui/chart.tsx\",\n        \"check\": \"npx tsc --noEmit\",\n    },\n    {\n        \"id\": \"prisma-libsql-config\",\n        \"title\": \"Fix PrismaLibSql client vs Config error\",\n        \"prompt\": \"\"\"You are fixing a Next.js + Prisma project.\n\nFile: src/lib/db/prisma.ts\n\nBuild fails:\nsrc/lib/db/prisma.ts(37,38): error TS2345: Argument of type 'Client' is not assignable\nto parameter of type 'Config'. Property 'url' is missing.\n\nCurrent code passes a libsql Client to PrismaLibSql. Fix: pass a config object\n{ url, authToken? } directly to PrismaLibSql instead of a Client.\nReturn ONLY the corrected file content, wrapped in tsx markdown fences.\nDo not explain.\"\"\",\n        \"file\": \"src/lib/db/prisma.ts\",\n        \"check\": \"npx tsc --noEmit\",\n    },\n    {\n        \"id\": \"delete-user-transaction\",\n        \"title\": \"Write deleteUser transaction rollback test\",\n        \"prompt\": \"\"\"You are writing a vitest test for a Next.js server action.\n\nFile: src/lib/admin-admin.test.ts\n\nFunction: deleteUser in src/lib/control-actions.ts (wraps prisma.$transaction inside safeDbQuery).\n\nWrite a vitest test that:\n1. Mocks @/auth so auth() returns { user: { id: \"admin123\", role: \"ADMIN\" } }\n2. Mocks @/lib/prisma with user.delete rejecting new Error(\"Database connection failed\")\n3. Calls deleteUser(\"userToDelete123\")\n4. Asserts result.success === false and result.error contains \"Database connection failed\"\n5. Mocks next/cache (revalidatePath, revalidateTag)\n\nReturn ONLY the test file content, wrapped in ts markdown fences. Do not explain.\"\"\",\n        \"file\": \"src/lib/admin-admin.test.ts\",\n        \"check\": \"npx vitest run src/lib/admin-admin.test.ts\",\n    },\n    {\n        \"id\": \"create-course-validation\",\n        \"title\": \"Create course Server Action with Zod\",\n        \"prompt\": \"\"\"You are writing a Next.js Server Action.\n\nFile: src/lib/server/actions/admin/courses.ts\n\nWrite createCourseAction(_prevState, formData): Promise<ActionResponseState> that:\n1. Calls requireAdmin() from \"./_shared\"\n2. Gets session from @/auth; returns unauthorized if no user id\n3. Validates with zod: title(min 2), slug(regex ^[a-z0-9-]+$), description(min 5), price(coerce number min 0)\n4. On validation failure returns { success: false, error: \"Validation failed\", fieldErrors }\n5. On success calls prisma.course.create inside safeDbQuery, revalidates /control/courses and /courses\n6. Returns safeDbQuery result\n\nImports:\nimport { prisma, safeDbQuery } from \"@/lib/prisma\";\nimport { revalidatePath } from \"next/cache\";\nimport { z } from \"zod\";\nimport { requireAdmin } from \"./_shared\";\nimport { auth } from \"@/auth\";\nimport type { ActionResponseState } from \"@/types\";\n\nReturn ONLY the file content, wrapped in ts markdown fences. Do not explain.\"\"\",\n        \"file\": \"src/lib/server/actions/admin/courses.ts\",\n        \"check\": \"npx tsc --noEmit\",\n    },\n    {\n        \"id\": \"env-db-fallback\",\n        \"title\": \"Fix DATABASE_URL SQLite fallback path\",\n        \"prompt\": \"\"\"Fix environment configuration.\n\nFile: src/env.ts\n\nCurrent: DATABASE_URL: z.string().min(1).catch(\"file:./prisma/dev2.db\")\n\nSQLite relative URLs resolve from schema dir (prisma/), so file:./prisma/dev2.db\nbecomes prisma/prisma/dev2.db (doesn't exist) -> \"Error code 14: Unable to open\".\n\nFix: change catch fallback to \"file:./dev.db\" (resolves to prisma/dev.db).\nReturn ONLY the corrected DATABASE_URL line, wrapped in ts markdown fences.\nDo not explain.\"\"\",\n        \"file\": \"src/env.ts\",\n        \"check\": \"npx tsc --noEmit\",\n    },\n]\n\n\ndef extract_code(text: str) -> str:\n    m = re.search(r\"```(?:ts|tsx|typescript)?\\n(.*?)\\n```\", text, re.DOTALL)\n    return m.group(1).strip() if m else text.replace(\"```\", \"\").strip()\n\n\ndef run_check(cmd: str, timeout: int = 180):\n    t0 = time.perf_counter()\n    try:\n        p = subprocess.run(cmd, shell=True, cwd=str(REPO),\n                           capture_output=True, text=True, timeout=timeout)\n        return {\n            \"ok\": p.returncode == 0,\n            \"seconds\": round(time.perf_counter() - t0, 3),\n            \"out\": (p.stderr or p.stdout or \"\")[-800:],\n        }\n    except subprocess.TimeoutExpired:\n        return {\"ok\": False, \"seconds\": None, \"out\": \"TIMEOUT\"}\n\n\ndef check_packages(code: str) -> bool:\n    pkg = json.loads((REPO / \"package.json\").read_text())\n    deps = {d.split(\"/\")[-1] for d in\n            list(pkg.get(\"dependencies\", {}).keys()) +\n            list(pkg.get(\"devDependencies\", {}).keys())}\n    imports = re.findall(r\"from ['\\\"](@?[^/'\\\"]+)\", code) + \\\n              re.findall(r\"require\\(['\\\"](@?[^/'\\\"]+)\", code)\n    for imp in imports:\n        name = imp.split(\"/\")[-1]\n        if name.startswith(\"@\") or name in (\"react\", \"next\", \"zod\", \"vitest\", \"typescript\"):\n            continue\n        if name not in deps:\n            print(f\"   [WARN] possible hallucinated import: {imp}\")\n            return False\n    return True\n\n\nclass GGUFModel:\n    def __init__(self, name: str, path: Path):\n        self.name = name\n        self.path = path\n        print(f\"Loading {name} from {path} ...\")\n        try:\n            self.llm = Llama(\n                model_path=str(path),\n                n_ctx=4096,\n                n_gpu_layers=-1,\n                n_batch=512,\n                verbose=False,\n                use_mlock=False,\n            )\n            self.device = \"gpu\"\n        except Exception as e:\n            print(f\"  GPU load failed ({e}), retrying CPU...\")\n            self.llm = Llama(\n                model_path=str(path),\n                n_ctx=4096,\n                n_gpu_layers=0,\n                n_batch=512,\n                verbose=False,\n                use_mlock=False,\n            )\n            self.device = \"cpu\"\n        print(f\"  Loaded on {self.device}\")\n\n    def generate(self, prompt: str, max_tokens: int = 512):\n        formatted = f\"<|system|>\\nYou are an expert coding assistant.\\n<|user|>\\n{prompt}\\n<|assistant|>\\n\"\n\n        start = time.perf_counter()\n        first_token = None\n        text = \"\"\n\n        stream = self.llm.create_completion(\n            prompt=formatted,\n            max_tokens=max_tokens,\n            temperature=0.0,\n            stream=True,\n        )\n        for chunk in stream:\n            if first_token is None:\n                first_token = time.perf_counter()\n            text += chunk[\"choices\"][0][\"text\"]\n\n        total = time.perf_counter() - start\n        ttft = round((first_token - start) if first_token else total, 3)\n        return text, round(ttft, 3), round(total, 3)\n\n\ndef evaluate(name: str, path: Path):\n    print(f\"\\n{'='*60}\\nModel: {name} ({path.name})\\n{'='*60}\")\n    model = GGUFModel(name, path)\n    results = {\"model\": name, \"path\": str(path), \"device\": model.device, \"cases\": []}\n\n    for case in PROMPTS:\n        print(f\"\\n  Case: {case['id']}\")\n        target = REPO / case[\"file\"]\n        original = target.read_text() if target.exists() else \"\"\n\n        gen, ttft, total = model.generate(case[\"prompt\"])\n        code = extract_code(gen)\n\n        target.write_text(code)\n        chk = run_check(case[\"check\"])\n        target.write_text(original)\n\n        pkgs_ok = check_packages(code)\n        passed = chk[\"ok\"] and pkgs_ok\n\n        results[\"cases\"].append({\n            \"id\": case[\"id\"],\n            \"title\": case[\"title\"],\n            \"ttft_seconds\": ttft,\n            \"total_seconds\": total,\n            \"check_passed\": chk[\"ok\"],\n            \"check_seconds\": chk.get(\"seconds\"),\n            \"packages_ok\": pkgs_ok,\n            \"passed\": passed,\n            \"check_output\": chk[\"out\"],\n        })\n        print(f\"    {'PASS' if passed else 'FAIL'}  check={chk['ok']} pkgs={pkgs_ok} ttft={ttft}s total={total}s\")\n\n    return results\n\nif __name__ == \"__main__\":\n    # MODELS is injected by the next cell\n    MODELS = []\n    all_results = [evaluate(n, p) for n, p in MODELS]\n    RESULTS.write_text(json.dumps(all_results, indent=2))\n    print(f\"\\nSaved {len(all_results)} model results to {RESULTS}\")"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "code",
   "id": "configure-and-run",
   "metadata": {},
   "source": [
    "from pathlib import Path\nimport json\nimport re\n\nMODELS_DIR = Path(\"/kaggle/working/models\")\ndiscovered = {}\nfor p in MODELS_DIR.glob(\"*.gguf\"):\n    name_lower = p.name.lower()\n    if \"qwen3\" in name_lower and \"30b\" in name_lower:\n        discovered[\"Qwen3-Coder-30B-A3B\"] = p\n    elif \"gemma\" in name_lower and \"12b\" in name_lower:\n        discovered[\"Gemma-4-12B-QAT\"] = p\n\n# Override manually if needed:\n# discovered = {\n#     \"Qwen3-Coder-30B-A3B\": Path(\"/kaggle/working/models/Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf\"),\n#     \"Gemma-4-12B-QAT\": Path(\"/kaggle/working/models/gemma-4-12b-it-qat-q4_0.gguf\"),\n# }\n\nharness_path = Path(\"/kaggle/working/eval_harness.py\")\ntext = harness_path.read_text()\nnew_models = \"MODELS = \" + repr([(k, str(v)) for k, v in discovered.items()]) + \"\\n\"\ntext = re.sub(r\"MODELS = \\[\\]\\n\", new_models, text, count=1)\nharness_path.write_text(text)\n\nprint(\"Configured models:\")\nfor name, p in discovered.items():\n    print(f\"  - {name}: {p}\")\n\n# Run the harness\n%run /kaggle/working/eval_harness.py"
   ],
   "outputs": [],
