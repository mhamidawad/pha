    "import os\nfrom pathlib import Path\n\nWORK = Path(\"/kaggle/working\")\nREPO = WORK / \"testa-phaglp2\"\nTOKEN = os.environ.get(\"GITHUB_TOKEN\")\n\nif not TOKEN:\n    raise SystemExit(\"Add GITHUB_TOKEN as a Kaggle notebook secret first\")\n\nif not REPO.exists():\n    print(\"Cloning...\")\n    os.system(f\"git clone https://{TOKEN}@github.com/mhamidawad/testa-phaglp2.git {REPO}\")\nelse:\n    print(\"Pulling latest master...\")\n    os.system(f\"cd {REPO} && git checkout master && git pull origin master\")\n\nprint(f\"Repo: {REPO} | {len(list(REPO.rglob('*')))} files\")"
   ],
