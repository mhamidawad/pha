  {
   "cell_type": "code",
   "id": "latency-accuracy-rubric",
   "metadata": {},
   "source": [
    "import json\nfrom pathlib import Path\n\nRESULTS = Path(\"/kaggle/working/eval_results.json\")\nif not RESULTS.exists():\n    raise SystemExit(\"Run the previous cell first to generate eval_results.json\")\n\ndata = json.loads(RESULTS.read_text())\n\n# Tune these weights\nLATENCY_WEIGHT = 1.0      # 0.5 = accuracy-first, 1.0 = balanced, 2.0 = speed-first\nACCURACY_FLOOR = 0.80     # min pass rate to be eligible\nMAX_HALLUCINATIONS = 0    # max allowed bad-import cases\n\nprint(f\"{'Model':<28} {'Pass':<7} {'Acc%':<6} {'Halluc':<8} {'TTFT(s)':<9} {'Total(s)':<10} {'Device':<6} {'Net':<7}  Tier\")\nprint(\"-\" * 110)\n\nscored = []\nfor m in data:\n    cases = m[\"cases\"]\n    total = len(cases)\n    passed = sum(1 for c in cases if c[\"passed\"])\n    accuracy = passed / total\n    halluc = sum(1 for c in cases if not c[\"packages_ok\"])\n    avg_ttft = sum(c[\"ttft_seconds\"] for c in cases) / total\n    avg_total = sum(c[\"total_seconds\"] for c in cases) / total\n    latency = avg_ttft + avg_total\n\n    net = round(accuracy * 100 - halluc * 10 - LATENCY_WEIGHT * latency, 1)\n\n    if accuracy >= ACCURACY_FLOOR and halluc <= MAX_HALLUCINATIONS:\n        if net >= 70:\n            tier = \"A \u2014 Architecture / Security / Cross-file\"\n        elif net >= 50:\n            tier = \"B \u2014 Mechanical edits only\"\n        else:\n            tier = \"C \u2014 Draft only (review everything)\"\n    else:\n        tier = \"\u2753 Reject (fails accuracy floor)\"\n\n    scored.append({\n        \"model\": m[\"model\"], \"passed\": passed, \"total\": total,\n        \"accuracy\": accuracy, \"halluc\": halluc,\n        \"ttft\": avg_ttft, \"total\": avg_total,\n        \"device\": m.get(\"device\", \"?\"), \"net\": net, \"tier\": tier,\n    })\n\n    print(f\"{m['model']:<28} {passed}/{total:<6} {accuracy*100:<6.0f} {halluc:<8} \"\n          f\"{avg_ttft:<9.2f} {avg_total:<10.2f} {m.get('device','?'):<6} {net:<7}  {tier}\")\n\nPath(\"/kaggle/working/model_scores.json\").write_text(json.dumps(scored, indent=2))\n\nprint(\"\\n\" + \"=\" * 110)\nbest = max(scored, key=lambda x: x[\"net\"])\nprint(f\"\\U0001f3c6 Best overall: {best['model']} (net {best['net']}, {best['device']}) \u2192 {best['tier'].split(' \u2014 ')[0]}\")\n\neligible = [s for s in scored if s[\"accuracy\"] >= ACCURACY_FLOOR and s[\"halluc\"] <= MAX_HALLUCINATIONS]\nif eligible:\n    arch = [s for s in eligible if s[\"tier\"].startswith(\"A\")]\n    mech = [s for s in eligible if s[\"tier\"].startswith(\"B\")]\n    if arch:\n        print(f\"\U0001f3e7  Architecture/Security/Debugging: {arch[0]['model']}\")\n    if mech:\n        print(f\"\u26a1  Mechanical edits / boilerplate: {mech[0]['model']}\")\nelse:\n    print(\"\\u26a0  No model cleared the accuracy floor. Use highest-net model as draft-only.\")\nprint(\"=\" * 110)"
   ],
